@url=http://localhost:3000

### Login con admin

# @name login
POST {{url}}/login
Content-Type: application/json

{
    "email": "mariano@gmail.com",
    "password": "minecraft123"
}


### Login sin admin

# @name login
POST {{url}}/login
Content-Type: application/json

{
    "email": "vicky@gmail.com",
    "password": "pomelo123"
}

###

@token = {{login.response.body.token}}

### Consultar todos usuarios
GET {{url}}/usuarios
Authorization: Bearer {{token}}

### Consultar usuario por ID
GET {{url}}/usuarios/1
Authorization: Bearer {{token}}

### Cargar usuario nuevo
POST {{url}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Gonzalo",
    "email": "gonza@gmail.com",
    "password":"tornado666",
    "esAdmin": false
}

### Editar usuario
PUT {{url}}/usuarios/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Gonza",
    "email": "gonzalito22@gmail.com",
    "password":"pantera222",
    "esAdmin": true
}

### Eliminar usuario

DELETE {{url}}/usuarios/8
Authorization: Bearer {{token}}

### Ver lista de vehículos

GET {{url}}/vehiculos
Authorization: Bearer {{token}}

### Consultar vehiculo por ID

GET {{url}}/vehiculos/2
Authorization: Bearer {{token}}

### Cargar vehiculo

POST {{url}}/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "marca": "Mercedes-Benz",
    "modelo": "Atego",
    "patente":"HTB283",
    "anio": 2021,
    "capacidad_carga": 78000
}

### Actualizar vehículo
PUT {{url}}/vehiculos/11
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "marca": "Mercedes-Benz",
    "modelo": "Atego v2",
    "patente":"LGP943",
    "anio": 2020,
    "capacidad_carga": 87000
}

### Eliminar vehículo
DELETE {{url}}/vehiculos/13
Authorization: Bearer {{token}}

### Ver listado de conductores
GET {{url}}/conductores
Authorization: Bearer {{token}}

### Ver listado de conductores por ID
GET {{url}}/conductores/1
Authorization: Bearer {{token}}

### Carga de conductor
POST {{url}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Franco",
    "apellido": "Colapinto",
    "numero_documento": 44223423,
    "numero_licencia": 24426424, 
    "fecha_alta_licencia": "2022-03-22",
    "fecha_vencimiento_licencia": "2027-03-22"
}

### Editar conductor
PUT {{url}}/conductores/5
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Fernando",
    "apellido": "Alonso",
    "numero_documento": 25533254,
    "numero_licencia": 94234223, 
    "fecha_alta_licencia": "2021-04-13",
    "fecha_vencimiento_licencia": "2026-12-30"
}

### Eliminar conductor
DELETE {{url}}/conductores/1
Authorization: Bearer {{token}}

### Listar viajes
GET {{url}}/viajes
Authorization: Bearer {{token}}

### Listar viajes por ID
GET {{url}}/viajes/2
Authorization: Bearer {{token}}

### Buscar viajes por ID de vehículo e ID de conductor
GET {{url}}/viajes/./filtrarPor?vehiculoId=1&conductorId=5
Authorization: Bearer {{token}}

### Crear viaje
POST {{url}}/viajes
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "vehiculo_id": 2,
    "conductor_id": 1,
    "fecha_salida": "2026-06-15",
    "fecha_llegada": "2026-06-17",
    "origen": "Sepang 1999, Ciudad Autónoma de Buenos Aires",
    "destino": "Mónaco 1988, Purmamarca, Jujuy",
    "kilometros": 1425.5,
    "observaciones": "El camión venía arrastrando un ovni chocado hace 200 km."    
}

### No se puede editar ni borrar un viaje. No hay PUT ni DELETE.